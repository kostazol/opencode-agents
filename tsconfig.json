{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "runtime",
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"]
}
